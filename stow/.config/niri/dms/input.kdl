input {
    mouse {
        accel-speed 0.0
    }
    touchpad {
        tap
        accel-speed 0.4
        accel-profile "adaptive"
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            layout "us_pt"
        }
        numlock
    }
}

